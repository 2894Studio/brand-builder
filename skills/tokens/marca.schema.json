{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2894Studio/brand-kit-builder/skills/tokens/marca.schema.json",
  "title": "marca.json",
  "description": "Contrato de marca.json de creative-architect (nombre, categoria, tono, palabrasProhibidas, idioma, visual) más extensiones opcionales de brand-kit-builder (tipografia, publico, competidores, brandKit). Los oficios de creative-architect ignoran los campos que no usan. La validación completa, incluidos contrastes y léxico, la hace tools/validar_marca.py.",
  "type": "object",
  "required": ["nombre", "categoria", "tono", "palabrasProhibidas", "idioma", "visual"],
  "properties": {
    "nombre": { "type": "string", "minLength": 1 },
    "categoria": { "type": "string", "minLength": 1 },
    "tono": { "type": "string", "minLength": 1 },
    "palabrasProhibidas": { "type": "array", "items": { "type": "string" } },
    "idioma": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "visual": {
      "type": "object",
      "required": ["colores", "estilo"],
      "properties": {
        "colores": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["nombre", "hex", "rol"],
            "properties": {
              "nombre": { "type": "string" },
              "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "rol": { "enum": ["primario", "fondo", "acento", "texto"] }
            }
          }
        },
        "estilo": { "type": "string", "minLength": 20 }
      }
    },
    "tipografia": {
      "type": "object",
      "required": ["titulos", "texto"],
      "additionalProperties": false,
      "properties": {
        "titulos": { "$ref": "#/$defs/familia" },
        "texto": { "$ref": "#/$defs/familia" }
      }
    },
    "publico": { "type": "string" },
    "competidores": { "type": "array", "items": { "type": "string" } },
    "brandKit": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "territorio": { "enum": ["artesanal", "editorial", "tecnologico", "natural", "cercano"] },
        "neutro": {
          "type": "object",
          "required": ["nombre", "hex"],
          "properties": { "nombre": { "type": "string" }, "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
        },
        "logo": { "type": "array", "items": { "type": "object", "required": ["version", "archivo"],
          "properties": { "version": { "enum": ["principal", "invertida", "monocroma", "simbolo", "reducida"] }, "archivo": { "type": "string" } } } },
        "tokens": { "type": "string" }
      }
    }
  },
  "$defs": {
    "familia": {
      "type": "object",
      "required": ["familia"],
      "properties": {
        "familia": { "type": "string" },
        "pesos": { "type": "array", "items": { "type": "integer" } },
        "licencia": { "type": "string" },
        "fuente": { "type": "string" }
      }
    }
  }
}
